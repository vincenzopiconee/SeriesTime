{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "seriestime-data",
          "appId": "1:192989615567:android:79e1fca8aad710cc98eeba",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "seriestime-data",
          "appId": "1:192989615567:ios:1b1b0980f98a362a98eeba",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "seriestime-data",
          "appId": "1:192989615567:ios:1b1b0980f98a362a98eeba",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "seriestime-data",
          "configurations": {
            "android": "1:192989615567:android:79e1fca8aad710cc98eeba",
            "ios": "1:192989615567:ios:1b1b0980f98a362a98eeba",
            "macos": "1:192989615567:ios:1b1b0980f98a362a98eeba",
            "web": "1:192989615567:web:ce572027f4e8820498eeba",
            "windows": "1:192989615567:web:df2d5bb297ac328798eeba"
          }
        }
      }
    }
  }
}
